# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Options (cost per 1M input/output tokens):
#   claude-sonnet-5   $3/$15  cheapest good option (intro $2/$10)
#   claude-opus-4-8   $5/$25  default — strong quality/cost balance
#   claude-fable-5    $10/$50 max capability
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8
EFFORT=high
MAX_TOKENS=16000

# Voyage AI (embeddings)
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3.5
EMBEDDING_DIMENSION=1024

# Pinecone
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=bullpen-concierge

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.30

# X mention bot — tag the account with a question, it answers from the
# transcripts. OAuth 1.0a user context: app-only tokens cannot post.
# From developer.x.com -> your app -> Keys and tokens.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# The bot's own numeric user id (not the @handle).
X_BOT_USER_ID=
# The live loop refuses to start without this, so credentials sitting in the
# environment are never enough on their own to start replying in public.
X_BOT_ENABLED=false
# Spend guard: ~$0.024 per answered question, so 100 replies is about $2.30.
X_BOT_DAILY_REPLY_CAP=100
# A post containing a URL costs $0.200 against $0.015 without one. Leave this
# off unless someone else is funding the difference.
X_BOT_INCLUDE_LINKS=false
X_BOT_POLL_SECONDS=60

X_BOT_CONTRACT_ADDRESS=
