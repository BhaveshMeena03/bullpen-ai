.env
.venv/
__pycache__/
*.pyc
redteam_report.md
data/episodes.json
/tmp/

deploy/*.log
data/.asset_cache/

# Raw eval answers — regenerable, and large. REPORT.md is the artifact.
evals/results.jsonl
evals/search_results.jsonl

# Rendered clips are build output, not source.
clips/
data/.usage.json

# Lock and staging files from concurrent writes to data/episodes.json.
# Local coordination only — nothing another checkout needs.
*.lock
*.json.tmp

# Runtime state for the X bot: which mentions it has already answered.
# Machine-local, and committing it would make one deploy re-answer another's
# backlog.
data/x_bot_state.json
